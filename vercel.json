{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "regions": ["fra1"],
  "env": {
    "APP_PUBLIC_ACCESS": "true"
  },
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/**,assets/**,vendor/hexph/hexph/**}",
      "excludeFiles": "{frontend/**,tools/**,tests/**,docs/**,tmp/**,vendor/originals/**,vendor/hexph/real/**,vendor/hexph/selfcheck-artifacts/**,vendor/hexph/tools/**,.venv/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
    ]}
  ]
}
