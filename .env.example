# Local development works with all fields empty (loopback only).
# Production: both auth values and private object storage are mandatory.
# APP_PASSWORD: at least 16 characters. SESSION_SECRET: independent random 32+.
APP_PASSWORD=
SESSION_SECRET=

# Cloudflare R2 or another S3-compatible private bucket.
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Alternative: Backblaze B2 S3-compatible private bucket (not Cloudflare R2).
# Replace the endpoint with the bucket's S3 endpoint, not a public download URL.
# S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_ACCESS_KEY_ID=<application key ID>
# S3_SECRET_ACCESS_KEY=<application key>
# Follow docs/DEPLOY-VERCEL.md for CORS and provider-specific lifecycle rules.

# Optional local adapter path (never used on Vercel).
# LOCAL_STORAGE_DIR=
